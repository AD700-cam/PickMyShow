# ==============================================================================
# PickMyShow - Environment Variables Configuration Template
# Use this template for local development, Render backend, or Vercel deployment
# ==============================================================================

# Core Django Settings
DEBUG=False
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=.onrender.com,.vercel.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.vercel.app

# Database Configuration (PostgreSQL on Render / Supabase / Neon)
# Leave blank or omit to default to SQLite (db.sqlite3)
DATABASE_URL=postgres://pickmyshow_user:password@dpg-xxxxxx-a.oregon-postgres.render.com/pickmyshow

# Celery & Asynchronous Task Processing
# Set CELERY_ALWAYS_EAGER=True on serverless or when Redis is not provisioned
CELERY_ALWAYS_EAGER=True
CELERY_BROKER_URL=redis://red-xxxxxx:6379/0
CELERY_RESULT_BACKEND=redis://red-xxxxxx:6379/0

# Razorpay Payment Gateway (Test Mode Credentials)
RAZORPAY_KEY_ID=rzp_test_TcNv01uLDhNUp8
RAZORPAY_KEY_SECRET=2Or4TJ6CYl0lUpC2oSWtVFnV
RAZORPAY_WEBHOOK_SECRET=pms_webhook_secret_free_67890

# Email Delivery (Gmail SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=pickmyshow0@gmail.com
EMAIL_HOST_PASSWORD=ojsxtkmqndpojabx
DEFAULT_FROM_EMAIL=PickMyShow <pickmyshow0@gmail.com>

# Evaluator Superuser Provisioning (Created automatically on build if not existing)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin123
DJANGO_SUPERUSER_EMAIL=admin@example.com
